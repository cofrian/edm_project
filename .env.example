ENV=development
DATA_DIR=./data/processed
MODEL_DIR=./models
ALLOW_ORIGINS=http://localhost:3000,https://edm-project.vercel.app

# Movilidad en tiempo real (opcional; por defecto usa Geoportal/EMT Valencia)
VALENCIA_VALENBISI_TTL_SECONDS=180
VALENCIA_EMT_STOPS_TTL_SECONDS=21600
VALENCIA_EMT_ARRIVALS_TTL_SECONDS=45
VALENCIA_EMT_ROUTES_TTL_SECONDS=21600
VALENCIA_EVENT_VALENBISI_RADIUS_METERS=1000
VALENCIA_EMT_DELAY_THRESHOLD_MINUTES=3
VALENCIA_EMT_AVG_SPEED_KMH=14
